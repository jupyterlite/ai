{
  "name": "jupyterlite-ai-monorepo",
  "version": "0.20.1",
  "private": true,
  "description": "Monorepo for JupyterLite AI - Agent and JupyterLab extension",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "jlpm build:all",
    "build:all": "jlpm workspace @jupyter-ai/persona-kit build && jlpm workspace @jupyter-ai/jupyternaut-frontend build",
    "build:prod": "jlpm workspace @jupyter-ai/persona-kit build:prod && jlpm workspace @jupyter-ai/jupyternaut-frontend build:prod",
    "clean": "jlpm workspace @jupyter-ai/persona-kit clean && jlpm workspace @jupyter-ai/jupyternaut-frontend clean",
    "clean:lintcache": "rimraf .eslintcache .stylelintcache",
    "clean:labextension": "rimraf python/jupyter-ai-jupyternaut-frontend/jupyter_ai_jupyternaut_frontend/labextension",
    "clean:all": "jlpm clean && jlpm clean:labextension && jlpm clean:lintcache",
    "docs": "jupyter book start",
    "docs:build": "sed -e 's/\\[@/[/g' -e 's/@/\\&#64;/g' CHANGELOG.md > docs/_changelog_content.md && jupyter book build --html",
    "eslint": "jlpm eslint:check --fix",
    "eslint:check": "eslint . --cache",
    "lint:check": "jlpm run prettier:check && jlpm run eslint:check && jlpm run stylelint:check",
    "lint": "jlpm run prettier && jlpm run eslint && jlpm run stylelint",
    "prettier": "prettier --write \"**/*{.ts,.tsx,.js,.jsx,.mjs,.css,.json,.md,.yml}\"",
    "prettier:check": "prettier --list-different \"**/*{.ts,.tsx,.js,.jsx,.mjs,.css,.json,.md,.yml}\"",
    "stylelint": "jlpm stylelint:check --fix",
    "stylelint:check": "stylelint --cache \"**/style/**/*.css\"",
    "sync:model-info": "jlpm workspace @jupyter-ai/jupyternaut-frontend run sync:model-info",
    "watch": "jlpm workspace @jupyter-ai/jupyternaut-frontend run watch"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@jupyter/eslint-plugin": "^1.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.1",
    "style-loader": "^3.3.1",
    "stylelint": "^15.10.1",
    "stylelint-config-recommended": "^13.0.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-csstree-validator": "^3.0.0",
    "stylelint-prettier": "^4.0.0",
    "typescript-eslint": "^8.65.0"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-recommended",
      "stylelint-config-standard",
      "stylelint-prettier/recommended"
    ],
    "plugins": [
      "stylelint-csstree-validator"
    ],
    "rules": {
      "csstree/validator": true,
      "property-no-vendor-prefix": null,
      "selector-class-pattern": "^([a-z][A-z\\d]*)(-[A-z\\d]+)*$|^Mui[A-Z]",
      "selector-no-vendor-prefix": null,
      "value-no-vendor-prefix": null
    }
  }
}
