{
  "name": "@jupyternaut/pi",
  "version": "0.20.1",
  "description": "The pi coding agent in JupyterLab and JupyterLite: a chat persona and a terminal command",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlite",
    "jupyterlab-extension",
    "pi"
  ],
  "homepage": "https://github.com/jupyterlite/ai",
  "bugs": {
    "url": "https://github.com/jupyterlite/ai/issues"
  },
  "license": "BSD-3-Clause",
  "author": "JupyterLite Contributors",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf,md}",
    "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
    "src/**/*.{ts,tsx}",
    "shims/*.{cjs,js}",
    "webpack.config.js"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/jupyterlite/ai.git",
    "directory": "packages/pi"
  },
  "scripts": {
    "build": "echo 'Building @jupyternaut/pi' && jlpm build:lib && jlpm build:labextension:dev",
    "build:dev": "echo 'Building @jupyternaut/pi' && jlpm build:lib && jlpm build:labextension:dev",
    "build:prod": "echo 'Building @jupyternaut/pi' && jlpm clean && jlpm build:lib:prod && jlpm build:labextension",
    "build:labextension": "jupyter-builder build .",
    "build:labextension:dev": "jupyter-builder build --development True .",
    "build:lib": "tsc --sourceMap",
    "build:lib:prod": "tsc",
    "clean": "jlpm clean:lib",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "install:extension": "jlpm build",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w --sourceMap",
    "watch:labextension": "jupyter-builder watch ."
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.0.3",
    "@earendil-works/pi-coding-agent": "^1.0.3",
    "@earendil-works/pi-mcp": "^1.0.3",
    "@earendil-works/pi-tui": "^1.0.3",
    "@jupyter-ai/persona-manager": "0.3.0-a0",
    "@jupyter/chat": "^0.25.0",
    "@jupyterlab/application": "^4.5.8",
    "@jupyterlab/apputils": "^4.6.8",
    "@jupyterlab/docmanager": "^4.5.8",
    "@jupyterlab/services": "^7.5.8",
    "@jupyterlite/cockle": "^1.7.1",
    "@jupyternaut/agent": "^0.20.1",
    "@lumino/commands": "^2.3.2",
    "@lumino/coreutils": "^2.2.1",
    "@lumino/signaling": "^2.1.4",
    "@mui/icons-material": "^7",
    "@mui/material": "^7",
    "@noble/hashes": "^2.0.1",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "jupyter-chat-components": "^0.7.0",
    "jupyter-mcp-manager": "^0.2.0",
    "memfs": "^4.17.0",
    "minimatch": "^10.2.6",
    "path-browserify": "^1.0.1",
    "react": "^18.3.1",
    "readable-stream": "^4.7.0",
    "string_decoder": "^1.3.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.2",
    "@types/node": "^24.3.0",
    "@types/react": "^18.0.26",
    "npm-run-all2": "^7.0.1",
    "rimraf": "^5.0.1",
    "typescript": "~5.8.0"
  },
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "styleModule": "style/index.js",
  "publishConfig": {
    "access": "public"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "../../python/jupyternaut-pi/jupyternaut_pi/labextension",
    "webpackConfig": "./webpack.config.js",
    "sharedPackages": {
      "buffer": false,
      "@earendil-works/pi-ai": false,
      "@earendil-works/pi-coding-agent": false,
      "@earendil-works/pi-mcp": false,
      "@earendil-works/pi-tui": false,
      "events": false,
      "@emotion/react": {
        "bundled": true,
        "singleton": true
      },
      "@jupyterlite/cockle": false,
      "@jupyter-ai/persona-manager": {
        "bundled": false,
        "singleton": true
      },
      "jupyter-chat-components": {
        "bundled": false,
        "singleton": true
      },
      "jupyter-mcp-manager": {
        "bundled": false,
        "singleton": true
      },
      "@jupyter/chat": {
        "bundled": false,
        "singleton": true
      },
      "@jupyternaut/agent": {
        "bundled": false,
        "singleton": true
      },
      "memfs": false,
      "minimatch": false,
      "@noble/hashes": false,
      "path-browserify": false,
      "readable-stream": false,
      "string_decoder": false
    }
  }
}
