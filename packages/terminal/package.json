{
  "name": "@jupyternaut/terminal",
  "version": "0.20.1",
  "description": "The pi coding agent as a command in the JupyterLite terminal",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlite",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/jupyterlite/ai",
  "bugs": {
    "url": "https://github.com/jupyterlite/ai/issues"
  },
  "license": "BSD-3-Clause",
  "author": "JupyterLite Contributors",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf,md}",
    "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
    "src/**/*.{ts,tsx}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/jupyterlite/ai.git",
    "directory": "packages/terminal"
  },
  "scripts": {
    "build": "echo 'Building @jupyternaut/terminal' && jlpm build:lib && jlpm build:labextension:dev",
    "build:dev": "echo 'Building @jupyternaut/terminal' && jlpm build:lib && jlpm build:labextension:dev",
    "build:prod": "echo 'Building @jupyternaut/terminal' && jlpm clean && jlpm build:lib:prod && jlpm build:labextension",
    "build:labextension": "jupyter-builder build .",
    "build:labextension:dev": "jupyter-builder build --development True .",
    "build:lib": "tsc --sourceMap",
    "build:lib:prod": "tsc",
    "clean": "jlpm clean:lib",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "install:extension": "jlpm build",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w --sourceMap",
    "watch:labextension": "jupyter-builder watch ."
  },
  "dependencies": {
    "@jupyterlab/application": "^4.5.8",
    "@jupyterlite/terminal": "^1.6.2",
    "@jupyternaut/pi": "^0.20.1"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.2",
    "npm-run-all2": "^7.0.1",
    "rimraf": "^5.0.1",
    "typescript": "~5.8.0"
  },
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "styleModule": "style/index.js",
  "publishConfig": {
    "access": "public"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "../../python/jupyternaut-terminal/jupyternaut_terminal/labextension",
    "sharedPackages": {
      "@jupyterlite/terminal": {
        "bundled": false,
        "singleton": true
      },
      "@jupyternaut/pi": {
        "bundled": false,
        "singleton": true
      }
    }
  }
}
