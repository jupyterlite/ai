{
  "name": "@jupyter-ai/persona-kit",
  "version": "0.20.1",
  "description": "A kit to build in-browser personas for Jupyter AI: tools, skills, settings and sign-in helpers",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/jupyterlite/ai",
  "bugs": {
    "url": "https://github.com/jupyterlite/ai/issues"
  },
  "license": "BSD-3-Clause",
  "author": "JupyterLite Contributors",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf,md}",
    "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
    "src/**/*.{ts,tsx}",
    "schema/*.json"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/jupyterlite/ai.git",
    "directory": "packages/persona-kit"
  },
  "scripts": {
    "build": "echo 'Building @jupyter-ai/persona-kit' && jlpm build:lib && jlpm build:labextension:dev",
    "build:dev": "echo 'Building @jupyter-ai/persona-kit' && jlpm build:lib && jlpm build:labextension:dev",
    "build:prod": "echo 'Building @jupyter-ai/persona-kit' && jlpm clean && jlpm build:lib:prod && jlpm build:labextension",
    "build:labextension": "jupyter-builder build .",
    "build:labextension:dev": "jupyter-builder build --development True .",
    "build:lib": "tsc --sourceMap",
    "build:lib:prod": "tsc",
    "clean": "jlpm clean:lib",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "install:extension": "jlpm build",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w --sourceMap",
    "watch:labextension": "jupyter-builder watch ."
  },
  "dependencies": {
    "@jupyterlab/application": "^4.5.8",
    "@jupyterlab/apputils": "^4.6.8",
    "@jupyterlab/coreutils": "^6.5.8",
    "@jupyterlab/docmanager": "^4.5.8",
    "@jupyterlab/rendermime": "^4.5.8",
    "@jupyterlab/services": "^7.5.8",
    "@jupyterlab/settingregistry": "^4.5.8",
    "@jupyterlab/translation": "^4.5.8",
    "@lumino/commands": "^2.3.2",
    "@lumino/coreutils": "^2.2.1",
    "@lumino/disposable": "^2.1.4",
    "@lumino/signaling": "^2.1.4",
    "@lumino/widgets": "^2.7.1",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.2",
    "@types/node": "^24.3.0",
    "css-loader": "^6.7.1",
    "npm-run-all2": "^7.0.1",
    "rimraf": "^5.0.1",
    "source-map-loader": "^1.0.2",
    "typescript": "~5.8.0"
  },
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "styleModule": "style/index.js",
  "publishConfig": {
    "access": "public"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "../../python/jupyter-ai-persona-kit/jupyter_ai_persona_kit/labextension",
    "schemaDir": "schema"
  }
}
