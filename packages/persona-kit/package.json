{
  "name": "@jupyter-ai/persona-kit",
  "version": "0.20.1",
  "description": "A kit to build in-browser personas for Jupyter AI: tools, skills, settings and sign-in helpers",
  "license": "BSD-3-Clause",
  "author": "JupyterLite Contributors",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{d.ts,js,js.map,json}",
    "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
    "src/**/*.{ts,tsx}"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jupyterlite/ai.git",
    "directory": "packages/persona-kit"
  },
  "scripts": {
    "build": "echo 'Building @jupyter-ai/persona-kit' && tsc --sourceMap",
    "build:prod": "echo 'Building @jupyter-ai/persona-kit' && jlpm clean && tsc",
    "clean": "rimraf lib tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@jupyterlab/coreutils": "^6.5.8",
    "@jupyterlab/rendermime": "^4.5.8",
    "@jupyterlab/services": "^7.5.8",
    "@jupyterlab/translation": "^4.5.8",
    "@lumino/commands": "^2.3.2",
    "@lumino/coreutils": "^2.2.1",
    "@lumino/disposable": "^2.1.4",
    "@lumino/signaling": "^2.1.4",
    "@lumino/widgets": "^2.7.1",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "rimraf": "^5.0.1",
    "typescript": "~5.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
